NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pitch demo seed (npm run seed:eintracht) — all accounts use:
# Password: CyclesGuard2026!  |  see docs/pitch/DEMO-ACCOUNTS.md

# Show demo credentials on /login (enable on pitch Vercel deploy only)
NEXT_PUBLIC_DEMO_MODE=false

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Cron auth (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate-a-long-random-string

# Consent audit IP hashing salt (Art. 9)
CONSENT_IP_SALT=generate-a-long-random-string

# Ingestion bridge (Sprint 8/9)
INGESTION_BASE_URL=http://localhost:8080
INGESTION_MANAGEMENT_KEY=changeme-local-dev-only

# Roles via Supabase Auth app_metadata.role:
# - player (default)
# - trainer  → /trainer/dashboard + team_members role=trainer
# - club_admin → /admin/teams + club_members
# - platform_admin → all clubs
